# Airtable
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Airtable Table IDs
TABLE_CUSTOMERS=tblXXXXXXXXXXXXXX
TABLE_BOOKINGS=tblXXXXXXXXXXXXXX
TABLE_TRIPS=tblXXXXXXXXXXXXXX
TABLE_BOOKING_CRM=tblXXXXXXXXXXXXXX
TABLE_LEADS=tblXXXXXXXXXXXXXX
# Supplies the coordinator name shown under each trip title.
# Without it, trips render with no booking manager.
TABLE_BOOKING_MANAGERS=tblXXXXXXXXXXXXXX

# Activity feed lives in Postgres, not Airtable — an append-only feed would
# consume the base's shared record limit and its 5-request-per-second cap.
# See db/schema.sql. Server only; never expose the service role key.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Airtable field names
AIRTABLE_CUSTOMERS_EMAIL_FIELD=Client Email

# SF "Good to know" generator. Runs on a schedule, writes SF Summary.
# CRON_SECRET must match the value Vercel sends — without it the endpoint
# would be a public button that spends money.
ANTHROPIC_API_KEY=
CRON_SECRET=
# SF_BATCH_SIZE=25

# Mailvio, for the subscriptions section. Server only — never expose.
# Use MAILVIO_API_KEY for a single account, or MAILVIO_API_KEYS to map
# Help Scout mailbox IDs to per-brand accounts:
#   {"123456":"key-for-patch","default":"fallback-key"}
MAILVIO_API_KEY=
# MAILVIO_API_KEYS=
# MAILVIO_BASE_URL=https://apiv2.mailvio.com

# Help Scout Mailbox API, from an OAuth2 app under Help Scout > Profile > My Apps.
# Used to read the website enquiry form out of a conversation (telephone,
# trip, message) and for "Copy last reply". Without it the lead form still
# works, prefilled from the Help Scout profile only.
HELPSCOUT_APP_ID=
HELPSCOUT_APP_SECRET=

# Lead form — the HelpScout Extractor extension, moved server-side.
# The two "Webhooks by Zapier" catch-hook URLs the extension posted to.
# Treat them as secrets: anyone holding one can create or change customers.
ZAPIER_CREATE_CUSTOMER_HOOK=
ZAPIER_UPDATE_CUSTOMER_HOOK=
# Preview deployments share the live Zaps. Set this to true (on Preview) to
# validate and display the payload without sending anything to Zapier.
# LEAD_DRY_RUN=true
# The Airtable token also needs schema.bases:read for the tag list.
# LEAD_TRIPS_VIEW=HelpScout Extension[All Trips]

# CRM deep links. Stacker today, TRTL later — change this one value to switch.
CRM_BASE_URL=https://leatherbacktravel.stackerhq.com

# Calendly booking links, keyed by Help Scout mailbox ID, with a "default"
# fallback. Without this the Calendly button renders with no destination.
# e.g. {"123456":"https://calendly.com/d/abc-def","default":"https://calendly.com/d/xyz"}
CALENDLY_URLS={"default":"https://calendly.com/d/your-link"}

# Help Scout - Workspace > Apps > your app > Secret Key.
# Help Scout signs the panel's URL with it; /api/session checks that signature
# and issues the session the lead form and enquiry lookup require.
HELPSCOUT_SECRET=your_helpscout_app_secret
# Once the signature check is proven in production, set this to true to make
# every /api route require a session. Until then the older routes stay open.
# REQUIRE_SESSION=true
